# Settings for a self-hosted OpenDocs instance. Copy to deploy/.env, replace
# example.com with your domain everywhere, and fill in the blanks.
# SELF_HOSTING.md walks through each service, and its "Configuration
# reference" lists every setting with its default.

# ---------------------------------------------------------------------------
# Your instance (required)
# ---------------------------------------------------------------------------

# The web app runs on this domain, the API on api.<domain>, the MCP server
# on mcp.<domain>. Point all three at the server in DNS.
OPENDOCS_DOMAIN=example.com
# An instance for your own team: no marketing site, no anonymous publishing
# or free tools, and (with BILLING_MODE=off) every feature for every account.
SELF_HOSTED=true
BILLING_MODE=off

BETTER_AUTH_URL=https://example.com
API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
MCP_RESOURCE_URL=https://mcp.example.com/mcp
CORS_ORIGINS=https://example.com
# Shares the sign-in between example.com and api.example.com.
AUTH_COOKIE_DOMAIN=.example.com

# A long random string: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Database (required): PostgreSQL 15+. Pick one.
#
# a) Built in (the default here): PostgreSQL in a container on this server.
#    Nothing to sign up for, but back it up yourself (SELF_HOSTING.md).
#    Generate a password (openssl rand -hex 24) and use it in both places.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=db
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://opendocs:<POSTGRES_PASSWORD>@db:5432/opendocs
#
# b) Hosted, such as Neon (neon.tech: a free tier, with backups). Delete the
#    three lines above and use its connection string instead:
# DATABASE_URL=postgresql://user:password@host/opendocs?sslmode=require

# ---------------------------------------------------------------------------
# Email (required for sign-in codes, invitations and password resets).
# Resend (resend.com), with your domain verified there.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=OpenDocs <noreply@example.com>

# ---------------------------------------------------------------------------
# File storage (needed for images in documents and workspace logos).
# Cloudflare R2, or any S3-compatible storage with R2_ENDPOINT.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opendocs
# The bucket's public address (an R2 custom domain or its r2.dev URL).
R2_PUBLIC_URL=https://assets.example.com
# Other S3-compatible storage instead of R2 (then R2_ACCOUNT_ID isn't needed):
# R2_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# R2_REGION=eu-west-1
# R2_FORCE_PATH_STYLE=true   # MinIO and some others

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Your company, on the legal pages' footers (you'll want your own terms).
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REGISTRATION=
LEGAL_ENTITY_COUNTRY=

# Sign in with GitHub or Google. Callback paths: /api/auth/callback/github
# and /api/auth/callback/google on https://example.com.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Drive and e-signatures (DocuSeal): stored credentials are encrypted
# with this key. openssl rand -base64 32, and never change it once set.
INTEGRATIONS_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Workspaces' own domains (notes.yourcompany.com) point a CNAME here.
CUSTOM_DOMAIN_CNAME_TARGET=custom.example.com

# Your own build of the browser extension (SELF_HOSTING.md): its ID.
EXTENSION_IDS=

# Close sign-ups once your team is in (invited people can't sign up either
# while it's on).
SIGNUPS_DISABLED=false

# Plausible analytics for your instance (leave empty for none).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Reverse-proxy hops in front of the API. 1 (unset) behind the Caddy in this
# stack; 2 if Cloudflare's proxy is on in front of it.
TRUST_PROXY_HOPS=
