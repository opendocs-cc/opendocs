# =============================================================================
# OpenDocs — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# These are opendocs.cc's settings. For a self-hosted instance, start from
# .env.self-hosted.example instead (see SELF_HOSTING.md).
# =============================================================================

# This instance. Caddy serves the web app on OPENDOCS_DOMAIN, the API on
# api., the MCP server on mcp. and the docs on docs. SELF_HOSTED=true is for
# an instance for one team (SELF_HOSTING.md).
OPENDOCS_DOMAIN=opendocs.cc
SELF_HOSTED=false
# docs.<domain>: the "docs" Compose profile builds and starts the docs
# container, and OPENDOCS_DOCS_SITE=on has Caddy serve it.
COMPOSE_PROFILES=docs
OPENDOCS_DOCS_SITE=on

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@your-neon-host.neon.tech/opendocs?sslmode=require

# Authentication
BETTER_AUTH_SECRET=generate-a-random-64-char-string
BETTER_AUTH_URL=https://opendocs.cc
AUTH_COOKIE_DOMAIN=.opendocs.cc

# API
API_URL=https://api.opendocs.cc
NEXT_PUBLIC_API_URL=https://api.opendocs.cc
CORS_ORIGINS=https://opendocs.cc
# Reverse-proxy hops in front of the API whose X-Forwarded-For it trusts for
# client addresses (rate limits key on them). Leave unset (default 1) behind
# the single Caddy in this stack. Set 0 if the API is ever reachable without
# a proxy that sets X-Forwarded-For (e.g. its port published), or clients
# can spoof their address and dodge every rate limit. Set 2 if Cloudflare's
# proxy is turned on in front of Caddy (and list Cloudflare's ranges in
# Caddy's trusted_proxies). See deploy/SETUP.md.
TRUST_PROXY_HOPS=

# MCP server (mcp.opendocs.cc). The web app issues OAuth access tokens for
# it and the API accepts them. Defaults shown; set MCP_RESOURCE_URL on any
# other instance (compose passes it to the MCP server too). The issuer is
# BETTER_AUTH_URL + /api/auth.
# MCP_RESOURCE_URL=https://mcp.opendocs.cc/mcp
# OAUTH_JWKS_URL=https://opendocs.cc/api/auth/jwks

# Browser extension IDs (comma-separated) whose chrome-extension:// origin
# gets CORS on the API and whose https://<id>.chromiumapp.org/ redirect URL
# the extension's OAuth client allows. Read by api and web. Production
# trusts only these (the development build's ID is not trusted when
# NODE_ENV=production); the Chrome Web Store ID is below, add each new
# store listing's ID.
EXTENSION_IDS=lhknacncecjennlcpdbfebdgnbdifbnc

# OAuth — GitHub (optional, enables "Sign in with GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth — Google (optional, enables "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integrations (Pro/Team): Google Drive and DocuSeal. Stored credentials
# are encrypted with this key; without it the Integrations tab can't connect
# anything. 32 random bytes: openssl rand -base64 32. Never change it once
# set, or every saved connection has to be made again.
INTEGRATIONS_ENCRYPTION_KEY=
# Google Drive: a separate OAuth client from sign-in (Web application) with
# redirect URI <BETTER_AUTH_URL>/dashboard/integrations/google-drive/callback,
# scope drive.file. The Picker needs an API key restricted to the Google
# Picker API and the Cloud project number (Drive API and Picker API enabled).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Email — Resend (optional, enables team invite emails)
RESEND_API_KEY=
EMAIL_FROM=OpenDocs <noreply@opendocs.cc>

# Custom domains (Pro and Team). Customers CNAME subdomains to the target,
# which is an A record to this VM in Cloudflare (DNS only). Root domains would
# use A records to CUSTOM_DOMAIN_IPV4 (comma-separated); opendocs.cc leaves it
# empty, so only subdomains are offered.
# Caddy asks the API's internal server (INTERNAL_PORT, not published) before
# issuing a certificate; see deploy/SETUP.md.
CUSTOM_DOMAIN_CNAME_TARGET=custom.opendocs.cc
CUSTOM_DOMAIN_IPV4=
INTERNAL_PORT=4001

# Feature flags
SIGNUPS_DISABLED=false

# Analytics — Plausible (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=opendocs.cc

# Document converter runs in this Compose stack with one worker, a 1 CPU
# quota and a 1500M memory cap. Port 8080 is not published on the host.
DOC_CONVERTER_URL=http://converter:8080
# Clone doc-converter alongside opendocs; resolved relative to deploy/.
DOC_CONVERTER_BUILD_CONTEXT=../../doc-converter

# Free tools' global limits (apps/api only, optional). The free converter
# and anonymous publishing have per-address limits plus global breakers
# shared by every client, which answer 503 service_busy once tripped.
# Leave these empty to keep the defaults in
# packages/shared/src/config/free-tools.ts (shown in brackets); set a whole
# number >= 1 to override one without a code change. Read per request, so
# recreating the API container is enough.
# Successful free conversions across all clients, per minute [30] and hour [600]:
FREE_CONVERTER_GLOBAL_PER_MINUTE=
FREE_CONVERTER_GLOBAL_PER_HOUR=
# New anonymous documents across all clients, per minute [60], hour [1000]
# and day [5000]:
ANONYMOUS_PUBLISH_GLOBAL_PER_MINUTE=
ANONYMOUS_PUBLISH_GLOBAL_PER_HOUR=
ANONYMOUS_PUBLISH_GLOBAL_PER_DAY=
# Reports from this many different addresses hide an anonymous page until
# the owner reviews it [3]:
ANONYMOUS_REPORTS_HIDE_AFTER=

# Cloudflare R2 — object storage for avatars, workspace logos, and inline
# post images. All five required on the API server; missing any of them
# disables upload endpoints but keeps the rest of the API working.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opendocs
R2_PUBLIC_URL=https://assets.opendocs.cc

# Export caching — cache rendered PDF/DOCX exports in R2 and serve repeated
# exports from cache. Identical inputs → ~200ms cache hit instead of ~4s
# converter round trip.
#
# Prerequisites before enabling:
#   1. R2 bucket has an Object Lifecycle Rule on prefix `exports/` that
#      deletes objects older than 90 days (limits storage growth).
#   2. R2_* vars above are set (flag is no-op without R2).
#
# Privacy: cached objects are streamed through the authenticated
# `/posts/:id/export/:format` endpoint — the R2 URL is never exposed.
# Cache key includes workspaceId, so no cross-tenant dedup.
EXPORT_CACHE_ENABLED=true

# =============================================================================
# Billing — Paddle
# =============================================================================
# Paddle is our Merchant of Record.
# Billing runs in apps/web for checkout/webhooks and in apps/api for automatic
# Team seat increases when accepted invites add a new unique member.
#
# IMPORTANT: the NEXT_PUBLIC_PADDLE_*_CLIENT_TOKEN vars are baked into the
# client bundle at BUILD TIME (Next.js inlines them). docker-compose.yml
# passes them as build args to apps/web/Dockerfile. If you change either
# client token you must rebuild the web image. Server-side PADDLE_* vars are
# read at runtime by both web and api through env_file: .env, so changing those
# only needs `docker compose up -d` to recreate the containers.
#
# BILLING_MODE controls which environment the integration talks to:
#   off         — all billing UI hidden, upgrade buttons disabled. Safe
#                 default for a fresh deploy before Paddle is configured,
#                 and a kill-switch if we ever need to disable billing.
#   sandbox     — sandbox-api.paddle.com. Test cards only, no real money.
#                 NEVER run this on the production domain with real users —
#                 they'll see a checkout that can't actually charge them.
#                 Use sandbox on a staging instance instead.
#   production  — api.paddle.com. Real cards, real money, real tax.
BILLING_MODE=off

# Everything on Team for every account, with nothing to pay: for a
# self-hosted instance without billing. true or false; unset, it follows
# SELF_HOSTED. Only works while BILLING_MODE=off, stores nothing, and turning
# it off puts everyone back on their own plan.
UNLOCK_ALL_FEATURES=

# Paddle sandbox credentials (from sandbox-vendors.paddle.com).
# Typically only populated on staging — prod leaves these empty and ships
# with BILLING_MODE=production once live credentials are verified.
PADDLE_SANDBOX_API_KEY=
NEXT_PUBLIC_PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_SANDBOX_PRO_MONTHLY_PRICE_ID=
PADDLE_SANDBOX_PRO_YEARLY_PRICE_ID=
PADDLE_SANDBOX_PRO_EXTRA_WORKSPACE_MONTHLY_PRICE_ID=
PADDLE_SANDBOX_PRO_EXTRA_WORKSPACE_YEARLY_PRICE_ID=
PADDLE_SANDBOX_TEAM_MONTHLY_PRICE_ID=
PADDLE_SANDBOX_TEAM_YEARLY_PRICE_ID=

# Paddle production credentials (from vendors.paddle.com). These are what
# prod actually runs on once BILLING_MODE=production. Create the catalog in
# the live dashboard with the same structure as sandbox — Pro + Team
# products, six prices total, Team prices with quantity.minimum=3.
# Price IDs are different from sandbox; the mapping is NOT portable.
PADDLE_LIVE_API_KEY=
NEXT_PUBLIC_PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_LIVE_PRO_MONTHLY_PRICE_ID=
PADDLE_LIVE_PRO_YEARLY_PRICE_ID=
PADDLE_LIVE_PRO_EXTRA_WORKSPACE_MONTHLY_PRICE_ID=
PADDLE_LIVE_PRO_EXTRA_WORKSPACE_YEARLY_PRICE_ID=
PADDLE_LIVE_TEAM_MONTHLY_PRICE_ID=
PADDLE_LIVE_TEAM_YEARLY_PRICE_ID=

# Founding-member price (optional). Pro at half price, locked in for as
# long as the subscription stays active, for anyone who subscribes before
# FOUNDER_OFFER_ENDS_AT (ISO 8601, e.g. 2026-11-30T23:59:59Z). It's one
# Paddle discount per environment: percentage 50, recurring, no maximum
# recurring intervals, restricted to the two Pro plan prices (not the
# extra-workspace prices), expires_at = the same deadline. The offer shows
# and applies only while the current environment's id is set and the
# deadline is ahead; leave these empty for no offer. Keep the id set after
# the deadline: it's how founders are recognized, and switching back to Pro
# from Team puts their discount back. FOUNDER_OFFER_STARTS_AT (optional,
# ISO 8601) keeps the offer closed until then, so everything can be set
# ahead of a launch date.
# Read at runtime, so changing them needs only `docker compose up -d`.
PADDLE_SANDBOX_FOUNDER_DISCOUNT_ID=
PADDLE_LIVE_FOUNDER_DISCOUNT_ID=
FOUNDER_OFFER_STARTS_AT=
FOUNDER_OFFER_ENDS_AT=

# The company that operates this instance, shown on the legal pages (terms,
# privacy, refund policy). Read by the web app at request time. Unset, the
# pages say "the operator of this service".
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REGISTRATION=
LEGAL_ENTITY_COUNTRY=

# Advertising: the optional ads add-on (see packages/ads/README.md).
# NEXT_PUBLIC_* values are baked into the web image at build time; rebuild
# the web image after changing them. ADS_DIR points the builds at a
# replacement for the placeholder add-on, inside the repository checkout.
NEXT_PUBLIC_AD_PIXELS_ENABLED=false
AD_PIXELS_ENABLED=false
ADS_DIR=

# Owner notifications on Telegram (optional). A private bot messages
# TELEGRAM_OWNER_ID (your numeric Telegram user id) when someone signs up or
# starts paying, and answers /stats; it ignores everyone else. Read by both
# api and web. In production the API registers the bot's webhook at startup.
# TELEGRAM_WEBHOOK_SECRET is any random string (openssl rand -hex 32) that
# Telegram sends back so the API knows a request is genuine.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=
