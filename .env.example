# Shared (both apps must use the same values)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opendocs
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Web app (apps/web)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# This instance's web address, for pages rendered in the browser (in
# deploy/, compose sets it from BETTER_AUTH_URL).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# An instance for one team: no marketing site, anonymous publishing or free
# tools, and every feature for everyone (SELF_HOSTING.md). The web app
# reads NEXT_PUBLIC_SELF_HOSTED, which compose sets from SELF_HOSTED.
SELF_HOSTED=false
NEXT_PUBLIC_SELF_HOSTED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email through Resend (read by web and api). Without it, sign up with a
# password; sign-in codes and invitations need email.
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
SIGNUPS_DISABLED=false  # Set to "true" to temporarily block new signups
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=  # e.g. example.com — leave empty to disable analytics

# The company that operates this instance, shown on the legal pages (terms,
# privacy, refund policy). Read by the web app at request time. Unset, the
# pages say "the operator of this service".
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REGISTRATION=  # e.g. registration number: 12345678
LEGAL_ENTITY_COUNTRY=  # country of incorporation

# API server (apps/api)
API_URL=http://localhost:4000
PORT=4000
CORS_ORIGINS=http://localhost:3000
# The document converter (github.com/opendocs-cc/doc-converter), for PDF and
# Word exports. Everything else works without it running.
DOC_CONVERTER_URL=http://localhost:8080
# Reverse-proxy hops whose X-Forwarded-For the API trusts for client IPs
# (every rate limit, and anonymous-page reports, key on that address).
# Defaults to 1, for the single Caddy in deploy/ that overwrites the header.
# IMPORTANT: set it to 0 whenever the API is reachable without going through
# a reverse proxy that sets X-Forwarded-For (e.g. its port published to the
# internet with no Caddy in front). With 1 and no proxy, a client picks its
# own address by sending the header, and so gets a fresh rate-limit bucket
# on every request. Behind more than one proxy (e.g. Cloudflare's
# orange cloud in front of Caddy), set the number of proxies.
TRUST_PROXY_HOPS=1

# Free tools' global limits (apps/api only, optional). The free converter
# and anonymous publishing have per-address limits plus global breakers
# shared by every client, which answer 503 service_busy once tripped.
# Leave these empty to keep the defaults in
# packages/shared/src/config/free-tools.ts (shown in brackets); set a whole
# number >= 1 to override one without a code change. Read per request, so
# recreating the API container is enough.
# Successful free conversions across all clients, per minute [30] and hour [600]:
FREE_CONVERTER_GLOBAL_PER_MINUTE=
FREE_CONVERTER_GLOBAL_PER_HOUR=
# New anonymous documents across all clients, per minute [60], hour [1000]
# and day [5000]:
ANONYMOUS_PUBLISH_GLOBAL_PER_MINUTE=
ANONYMOUS_PUBLISH_GLOBAL_PER_HOUR=
ANONYMOUS_PUBLISH_GLOBAL_PER_DAY=
# Reports from this many different addresses hide an anonymous page until
# the owner reviews it [3]:
ANONYMOUS_REPORTS_HIDE_AFTER=

# Browser extension IDs (comma-separated) whose chrome-extension:// origin
# gets CORS on the API and whose https://<id>.chromiumapp.org/ redirect URL
# the extension's OAuth client allows. Read by api and web. The development
# build's ID (packages/shared/src/extension/config.ts) is added automatically
# unless NODE_ENV=production; list the store IDs here.
EXTENSION_IDS=

# Integrations: Google Drive and e-signatures (DocuSeal). Read by web and api.
# Saved connections are encrypted with INTEGRATIONS_ENCRYPTION_KEY; without
# it the Integrations tab can't connect anything. 32 random bytes:
# openssl rand -base64 32. Never change it once set, or every saved
# connection has to be made again. DocuSeal needs nothing here; each
# workspace enters its own credentials.
INTEGRATIONS_ENCRYPTION_KEY=
# Google Drive: a separate OAuth client from sign-in (Web application) with
# redirect URI <BETTER_AUTH_URL>/dashboard/integrations/google-drive/callback,
# scope drive.file. The Picker needs an API key restricted to the Google
# Picker API and the Cloud project number (Drive API and Picker API enabled).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# MCP server (apps/mcp, optional). Access tokens are bound to this URL, so
# web and api need it too when you run the MCP server locally; unset, it's
# https://mcp.opendocs.cc/mcp. The MCP server's own settings go in
# apps/mcp/.env (README.md).
# MCP_RESOURCE_URL=http://localhost:4100/mcp

# Custom domains (Pro and Team): a workspace serves its documents on its own
# domain, e.g. notes.example.com. Read by the API (DNS checks, the records
# the dashboard shows, Caddy's tls-ask) and the web app.
#
# CUSTOM_DOMAIN_CNAME_TARGET is what customers point a subdomain's CNAME at.
# CUSTOM_DOMAIN_IPV4 is our server's IPv4 address(es), comma-separated, for
# root (apex) domains with A records. Leave it empty, as on opendocs.cc:
# only subdomains with a CNAME are offered.
# INTERNAL_API_URL is how the web app reaches the API from the server (the
# custom-domain download route); defaults to API_URL.
# INTERNAL_PORT is the API's second, internal server for Caddy's on-demand
# TLS `ask` (GET /internal/tls-ask). Never publish or proxy it.
#
# Local testing: *.localhost resolves to your machine, so connect
# notes.localhost to a Pro/Team workspace and open http://notes.localhost:3000.
# CUSTOM_DOMAINS_DEV_SKIP_DNS=1 marks a domain active without DNS records;
# it's ignored when NODE_ENV=production.
CUSTOM_DOMAIN_CNAME_TARGET=custom.example.com
CUSTOM_DOMAIN_IPV4=
INTERNAL_PORT=4001
CUSTOM_DOMAINS_DEV_SKIP_DNS=

# Cloudflare R2 (object storage for avatars, workspace logos, and inline
# post images). All five are required to enable uploads; if any are missing
# the upload endpoints return 503 `storage_not_configured` and the rest of
# the API keeps working. Only the API server (apps/api) reads these — the
# web app never needs R2 credentials.
#
# How to get them (one-time setup):
#   1. Cloudflare dashboard → R2 → create a bucket, e.g. `opendocs`.
#   2. R2 → Manage R2 API Tokens → Create API token → "Object Read & Write"
#      scoped to that bucket. Save the Access Key ID + Secret.
#   3. Your Account ID is shown in the R2 sidebar ("Account details").
#   4. Expose the bucket read-side at a public URL. Two options:
#      (a) Preferred: connect a custom domain in R2 → Settings → Custom
#          Domains, e.g. assets.example.com.
#      (b) For local development: enable "Public Development URL" to get a
#          pub-<hash>.r2.dev subdomain and use that instead.
#      Either way: the bucket itself stays private — only objects whose
#      keys we hand out (workspace logos, cached exports) are reachable,
#      and export caches are served via the API, not the public URL.
#   5. Add this CORS policy to the bucket so browser uploads work:
#      [{"AllowedOrigins":["http://localhost:3000","https://example.com"],
#        "AllowedMethods":["GET","PUT","HEAD"],
#        "AllowedHeaders":["*"]}]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Any other S3-compatible storage instead of R2 (R2_ACCOUNT_ID then isn't
# needed): R2_ENDPOINT, plus R2_REGION and R2_FORCE_PATH_STYLE=true when it
# needs them (MinIO).
# R2_ENDPOINT=
# R2_REGION=
# R2_FORCE_PATH_STYLE=false

# Billing — Paddle (apps/web only). Paddle is the Merchant of Record.
#
# BILLING_MODE selects which environment the integration talks to:
#   off         — hides all billing UI; upgrade buttons disabled. Default for
#                 local dev without Paddle configured, and a kill-switch for
#                 production if we ever need to disable billing in a hurry.
#   sandbox     — uses sandbox-api.paddle.com. Real card numbers fail; use
#                 Paddle's test cards (e.g. 4242 4242 4242 4242). No real money
#                 moves. Webhook retries stop after 15 min (vs 3 days in prod).
#   production  — uses api.paddle.com. Real cards, real money, tax collection
#                 on. Only flip once the sandbox flow is fully tested end-to-end.
#
# The flag swaps the entire config bundle below (API key + client token +
# webhook secret + all six price IDs), because Paddle price IDs are NOT
# portable between sandbox and production — the catalog must be created
# twice, once in each environment.
BILLING_MODE=off

# Everything on Team for every account, with nothing to pay: for a
# self-hosted instance without billing. true or false; unset, it follows
# SELF_HOSTED. Only works while BILLING_MODE=off, stores nothing, and turning
# it off puts everyone back on their own plan.
UNLOCK_ALL_FEATURES=

# Paddle sandbox credentials. Get from sandbox-vendors.paddle.com:
#   - API key + client token: Developer tools → Authentication
#   - Webhook secret: Developer tools → Notifications → create a destination
#     pointing at https://<your-tunnel>.ngrok.app/api/paddle/webhook, then
#     copy the endpoint secret (pdl_ntfset_…).
#   - Price IDs: Catalog → Products.
PADDLE_SANDBOX_API_KEY=
NEXT_PUBLIC_PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_SANDBOX_PRO_MONTHLY_PRICE_ID=
PADDLE_SANDBOX_PRO_YEARLY_PRICE_ID=
PADDLE_SANDBOX_PRO_EXTRA_WORKSPACE_MONTHLY_PRICE_ID=
PADDLE_SANDBOX_PRO_EXTRA_WORKSPACE_YEARLY_PRICE_ID=
PADDLE_SANDBOX_TEAM_MONTHLY_PRICE_ID=
PADDLE_SANDBOX_TEAM_YEARLY_PRICE_ID=

# Paddle production credentials. Same structure as sandbox, from
# vendors.paddle.com. Leave empty until the sandbox integration has been
# fully tested — flipping BILLING_MODE=production with unset live vars will
# throw on boot (this is intentional — better than a silent misconfig).
PADDLE_LIVE_API_KEY=
NEXT_PUBLIC_PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_LIVE_WEBHOOK_SECRET=
PADDLE_LIVE_PRO_MONTHLY_PRICE_ID=
PADDLE_LIVE_PRO_YEARLY_PRICE_ID=
PADDLE_LIVE_PRO_EXTRA_WORKSPACE_MONTHLY_PRICE_ID=
PADDLE_LIVE_PRO_EXTRA_WORKSPACE_YEARLY_PRICE_ID=
PADDLE_LIVE_TEAM_MONTHLY_PRICE_ID=
PADDLE_LIVE_TEAM_YEARLY_PRICE_ID=

# Founding-member price (optional). Pro at half price, locked in for as
# long as the subscription stays active, for anyone who subscribes before
# FOUNDER_OFFER_ENDS_AT (ISO 8601, e.g. 2026-11-30T23:59:59Z). It's one
# Paddle discount per environment: percentage 50, recurring, no maximum
# recurring intervals, restricted to the two Pro plan prices (not the
# extra-workspace prices), expires_at = the same deadline. The offer shows
# and applies only while the current environment's id is set and the
# deadline is ahead; leave these empty for no offer. Keep the id set after
# the deadline: it's how founders are recognized, and switching back to Pro
# from Team puts their discount back. FOUNDER_OFFER_STARTS_AT (optional,
# ISO 8601) keeps the offer closed until then, so everything can be set
# ahead of a launch date.
PADDLE_SANDBOX_FOUNDER_DISCOUNT_ID=
PADDLE_LIVE_FOUNDER_DISCOUNT_ID=
FOUNDER_OFFER_STARTS_AT=
FOUNDER_OFFER_ENDS_AT=

# Export caching (apps/api only). When true, rendered PDF/DOCX exports are
# cached in R2 under `exports/<workspaceId>/…` keyed by a SHA-256 hash of the
# content + branding. Identical re-exports skip the doc-converter and stream
# from R2 instead (typically ~200ms vs ~4s). Requires R2 to be configured
# above — if R2_* is missing this flag is silently ignored.
#
# Privacy: cached objects are served exclusively through the authenticated
# `/posts/:id/export/:format` API endpoint — the R2 URL is never exposed to
# clients.
#
# Default `false` is safe for local dev. Flip to `true` in staging/prod once
# the bucket has a 90-day lifecycle rule on the `exports/` prefix.
EXPORT_CACHE_ENABLED=false


# Advertising
# Master switch for the optional ads add-on (packages/ads): ad pixels in the
# browser and server-side conversion events. Keep false for local dev and
# previews. With the placeholder add-on these do nothing either way: only an
# add-on reads AD_PIXELS_ENABLED, and its own settings are documented with it.
NEXT_PUBLIC_AD_PIXELS_ENABLED=false
AD_PIXELS_ENABLED=false

# Owner notifications on Telegram (optional). A private bot messages
# TELEGRAM_OWNER_ID (your numeric Telegram user id) when someone signs up or
# starts paying, and answers /stats; it ignores everyone else. Read by both
# api and web. In production the API registers the bot's webhook at startup.
# TELEGRAM_WEBHOOK_SECRET is any random string (openssl rand -hex 32) that
# Telegram sends back so the API knows a request is genuine.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=
